# Copy to .env. Never commit .env. Use a secret manager in production.
POSTGRES_USER=tailoring
POSTGRES_PASSWORD=change_me_locally
WEB_BASE_URL=http://localhost:3000

# Seed the initial subscription plans on startup (inserts missing plans/keys only). Always on in Development.
Billing__SeedPlansOnStartup=false

# Public site hosting
BASE_DOMAIN=localhost
API_PUBLIC_URL=http://localhost:8080
TURNSTILE_SITE_KEY=

# Mobile bearer sign-in (leave empty to keep it off). 32+ random characters: openssl rand -base64 48
Auth__JwtSigningKey=
Auth__RequireVerifiedEmail=false
