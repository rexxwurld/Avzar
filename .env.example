# Copy to .env. Never commit .env. Use a secret manager in production.
POSTGRES_USER=tailoring
POSTGRES_PASSWORD=change_me_locally
WEB_BASE_URL=http://localhost:3000

# Seed the initial subscription plans on startup (inserts missing plans/keys only). Always on in Development.
Billing__SeedPlansOnStartup=false

# Public site hosting
BASE_DOMAIN=localhost
API_PUBLIC_URL=http://localhost:8080
TURNSTILE_SITE_KEY=

# Mobile bearer sign-in (leave empty to keep it off). 32+ random characters: openssl rand -base64 48
Auth__JwtSigningKey=
Auth__RequireVerifiedEmail=false

# ---------------------------------------------------------------------------
# Production / hosted API (Render, Fly, ...). Set these as environment variables
# in the host's dashboard, NOT in a committed file. Values below are examples.
# ---------------------------------------------------------------------------

# Database (Npgsql format) and public web URL used in email links
ConnectionStrings__Default=
App__WebBaseUrl=https://your-web-host.example
# Public HTTPS web origin used to build the single-use ownership-transfer confirmation link.
# Ownership transfer requests fail closed if this is unset or not HTTPS.
App__PublicBaseUrl=https://your-web-host.example

# Hosts with no shell (Render): apply EF migrations at startup. Seed plans once AFTER the first migrated start.
Database__MigrateOnStartup=true
Billing__SeedPlansOnStartup=false

# Behind a TLS-terminating proxy (Render, Fly, Caddy): trust X-Forwarded-For/-Proto.
# Required for correct per-client rate limits and the HTTPS redirect. Only true when the API is reachable ONLY through the proxy.
Proxy__TrustForwardedHeaders=true

# Email. 'log' only writes messages to the log (development). Use 'resend' or 'smtp' in production.
Email__Provider=log
Email__FromAddress=
Email__FromName=Avzar
Email__Resend__ApiKey=
Email__Resend__WebhookSecret=
# SMTP alternative: Email__Smtp__Host, Email__Smtp__Port=587, Email__Smtp__UseStartTls=true, Email__Smtp__Username, Email__Smtp__Password

# Quieter logs: stop the outbox poller's SQL from being logged every few seconds
Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning

# Optional Redis integration (see docs/RUNBOOK.md). Enables shared rate limits, SignalR backplane and the Redis Streams job queue.
Redis__ConnectionString=
Storage__Provider=local
Storefront__BaseDomain=
Storefront__CaptchaSecretKey=
Pdf__QuestPdfLicense=


# Optional AI features. Keep provider keys only in the hosting provider's secret settings.
AI__OpenAI__ApiKey=
AI__OpenAI__TextModel=gpt-4.1-mini
AI__OpenAI__ImageModel=gpt-image-1

# Optional Paystack subscription checkout (NGN plans only). Webhook URL: /api/billing/subscription/webhook
Billing__Paystack__SecretKey=
Billing__Paystack__CallbackUrl=https://your-web-host.example/settings/billing

# Platform administrator allowlist for global plan editing. Set only trusted staff emails in deployment secrets.
# PlatformAdmin__Emails__0=platform-admin@example.com

# Request boundary for the temporary ASP.NET API proxy (25 MiB default).
MAX_PROXY_BODY_BYTES=26214400
UPSTREAM_TIMEOUT_MS=30000

# Daily, deduplicated reminders for assigned production tasks that remain overdue.
Notifications__OverdueTaskRemindersEnabled=true
Notifications__OverdueTaskReminderPollSeconds=900
