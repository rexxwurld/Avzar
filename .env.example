# Copy to .env. Never commit .env. Use a secret manager in production.
POSTGRES_USER=avzar
POSTGRES_PASSWORD=change_me_locally
WEB_BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=8081
HOST=0.0.0.0
DATABASE_URL=postgresql://avzar:change_me_locally@localhost:5432/avzar_node_dev
DATABASE_POOL_MAX=10

# Public site hosting.
BASE_DOMAIN=localhost
API_PUBLIC_URL=http://localhost:8081
TURNSTILE_SITE_KEY=

# Mobile bearer auth. Use a 32+ character key in real deployments.
JWT_SIGNING_KEY=
JWT_ISSUER=avzar-api
JWT_AUDIENCE=avzar-mobile
ACCESS_TOKEN_MINUTES=10
REFRESH_IDLE_DAYS=30
REFRESH_ABSOLUTE_DAYS=90
MAX_SESSIONS_PER_USER=10
REQUIRE_VERIFIED_EMAIL=false
LOG_LEVEL=info

# Optional business settings and provider integrations.
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Avzar
EMAIL_RESEND_API_KEY=
EMAIL_RESEND_WEBHOOK_SECRET=
AI_OPENAI_API_KEY=
AI_OPENAI_TEXT_MODEL=gpt-4.1-mini
AI_OPENAI_IMAGE_MODEL=gpt-image-1
BILLING_PAYSTACK_SECRET_KEY=
BILLING_PAYSTACK_CALLBACK_URL=https://your-web-host.example/settings/billing
STORAGE_PROVIDER=local
STORE_FRONT_BASE_DOMAIN=
STORE_FRONT_CAPTCHA_SECRET_KEY=
PDF_QUESTPDF_LICENSE=

# Keep production secrets out of source control.
# Set provider keys and long-lived tokens in your host secrets manager, not here.
