# Parallel Node/PWA service. Do not add production credentials to this file.
NODE_ENV=development
PORT=8081
HOST=0.0.0.0
# PostgreSQL connection for the Node API.
DATABASE_URL=postgresql://avzar:change-me@localhost:5432/avzar_node_dev
DATABASE_POOL_MAX=10
# Mobile bearer authentication remains disabled until a 32+ character key is configured.
JWT_SIGNING_KEY=
JWT_ISSUER=avzar-api
JWT_AUDIENCE=avzar-mobile
ACCESS_TOKEN_MINUTES=10
REFRESH_IDLE_DAYS=30
REFRESH_ABSOLUTE_DAYS=90
MAX_SESSIONS_PER_USER=10
REQUIRE_VERIFIED_EMAIL=false
LOG_LEVEL=info
# Account links (email confirmation / password reset). Falls back to JWT_SIGNING_KEY when unset; needs >= 32 characters.
# ACCOUNT_TOKEN_KEY=
WEB_BASE_URL=http://localhost:3000
PRODUCT_NAME=Avzar
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=30
EMAIL_THROTTLE_SECONDS=120
