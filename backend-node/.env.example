# Parallel Node/PWA service. Do not add production credentials to this file.
NODE_ENV=development
PORT=8081
HOST=0.0.0.0
# Existing ASP.NET API remains authoritative until domain-by-domain migration is verified.
API_URL=http://localhost:8080
# Set true only if your controlled hosting ingress sanitizes/appends X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Future Node API database connection; do not point this at production until migrations and access are reviewed.
DATABASE_URL=postgresql://avzar:change-me@localhost:5432/avzar_node_dev
LOG_LEVEL=info

# Request boundary for the temporary ASP.NET API proxy (25 MiB default).
MAX_PROXY_BODY_BYTES=26214400
UPSTREAM_TIMEOUT_MS=30000
