{
  "expo": {
    "name": "Avzar",
    "slug": "avzar-mobile",
    "scheme": "avzar",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rexxwurld.avzar"
    },
    "android": {
      "package": "com.rexxwurld.avzar"
    }
  }
}
