# Server-side address of the Avzar API (inside docker: http://api:8080)
API_URL=http://localhost:8080
# Address BROWSERS use for images (/public/media/...). Usually the same API, public.
NEXT_PUBLIC_API_PUBLIC_URL=http://localhost:8080
# Sites live at {slug}.BASE_DOMAIN. Must match Storefront__BaseDomain on the API.
BASE_DOMAIN=localhost
# Optional Cloudflare Turnstile site key (the API needs Storefront__CaptchaSecretKey too)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
